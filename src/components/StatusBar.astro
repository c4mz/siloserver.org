---
import BrandLockup from "./BrandLockup.astro";
import { SITE, REPOS, repoUrl } from "../data/siteConfig";
---

<header class="statusbar" aria-label="Project status">
  <div class="statusbar__inner">
    <a
      class="statusbar__cell statusbar__cell--brand"
      href="/"
      aria-label={`${SITE.name} home`}
    >
      <BrandLockup />
    </a>
    <nav class="statusbar__nav statusbar__nav--primary" aria-label="Primary">
      <a href="/#features">Features</a>
      <a href="/#clients">Clients</a>
      <a href="/#stack">Stack</a>
      <a href="/docs">Docs</a>
      <a href="/brand">Brand</a>
    </nav>
    <div class="statusbar__nav statusbar__nav--end">
      <!-- aria-label is set explicitly: below 1140px the labels are hidden
           and only the marks remain. -->
      <a href={SITE.discord} class="statusbar__nav-icon" aria-label="Discord">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127c-.598.35-1.22.644-1.873.891a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.056c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.029ZM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418Z"
          ></path></svg
        >
        <span>Discord</span>
      </a>
      <a
        href={repoUrl(REPOS.server)}
        class="statusbar__nav-icon"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.573C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path></svg
        >
        <span>GitHub</span>
      </a>
      <button
        type="button"
        id="themeToggle"
        class="statusbar__theme"
        aria-label="Theme: auto (follow system)"
        title="Cycle theme — auto / light / dark"
      >
        <svg class="sys" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="13" rx="1.5"></rect><path d="M8.5 21h7M12 17.5V21"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.4 19.6l1.6-1.6M18 6l1.6-1.6"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 14.8A8.2 8.2 0 0 1 9.2 3.5 7.2 7.2 0 1 0 20.5 14.8z"></path></svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // The bar is transparent so the page's gradient runs up behind it, but it
  // is also sticky — so once the page scrolls, content would pass straight
  // through it and collide with the links. Flag the scrolled state and let
  // the stylesheet put the plate back; over the hero it stays clear.
  (function () {
    var bar = document.querySelector(".statusbar");
    if (!bar) return;
    var stuck = null;
    function sync() {
      var now = window.scrollY > 8;
      if (now === stuck) return; // only touch the DOM on a real transition
      stuck = now;
      bar.classList.toggle("is-stuck", now);
    }
    addEventListener("scroll", sync, { passive: true });
    sync(); // a reload can restore a scrolled position
  })();
</script>
